# Copiare in .env sul computer Edge. Non committare il file risultante.
EM_EDGE_HOSTNAME=energy-manager.local
EM_SECRET_KEY=GENERARE_UN_VALORE_CASUALE_DI_ALMENO_48_CARATTERI
EM_EDGE_TOKEN=GENERARE_UN_TOKEN_CASUALE_DISTINTO
EM_WEBHOOK_SECRET=GENERARE_UN_SEGRETO_CASUALE_DISTINTO
EM_BOOTSTRAP_ADMIN_PASSWORD=IMPOSTARE_PASSWORD_UNICA_DI_ALMENO_14_CARATTERI

EM_SYNC_ENABLED=false
EM_CONTROL_ROOM_URL=https://control-room.invalid
EM_TELEMETRY_RETENTION_DAYS=730
EM_SENT_OUTBOX_RETENTION_DAYS=30
EM_BACKUP_ENABLED=true
EM_BACKUP_INTERVAL_HOURS=24
EM_BACKUP_RETENTION_COUNT=14
# Abilitare solo quando il servizio host Edge incaricato di applicare i profili di rete è installato.
EM_NETWORK_MANAGEMENT_ENABLED=false

# Solo se si usa Modbus RTU con docker-compose.rtu.yml
EM_RTU_DEVICE=/dev/ttyUSB0
