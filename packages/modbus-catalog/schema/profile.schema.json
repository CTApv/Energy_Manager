{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-manager.local/schema/modbus-profile-1.0.json",
  "title": "Energy Manager Modbus driver catalog",
  "oneOf": [
    { "$ref": "#/$defs/profile" },
    {
      "type": "object",
      "required": ["bundle_version", "profiles"],
      "properties": {
        "bundle_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "point_sets": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/point" } } },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bundledProfile" } }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "required": ["key", "label", "function_code", "address", "register_count", "data_type"],
      "properties": {
        "key": { "type": "string", "minLength": 3, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "function_code": { "enum": [1, 2, 3, 4] },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "register_count": { "type": "integer", "minimum": 1, "maximum": 125 },
        "data_type": { "enum": ["boolean", "bit_field", "int16", "uint16", "int32", "uint32", "float32", "int64", "uint64", "float64", "ascii"] },
        "byte_order": { "enum": ["big", "little"] },
        "word_order": { "enum": ["big", "little"] },
        "scale": { "type": "number" }, "offset": { "type": "number" },
        "unit": { "type": "string" }, "access": { "const": "read" },
        "polling_group": { "type": "string" }, "group": { "type": "string" },
        "enum": { "type": "object", "additionalProperties": { "type": "string" } },
        "bit": { "type": "integer", "minimum": 0, "maximum": 63 }
      },
      "additionalProperties": false
    },
    "derivedPoint": {
      "type": "object",
      "required": ["key", "label", "operation", "sources"],
      "properties": {
        "key": { "type": "string", "minLength": 3 }, "label": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["sum", "mean", "difference"] },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "unit": { "type": "string" }, "group": { "type": "string" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "enum": ["unverified", "simulated", "manual_reviewed", "hardware_tested", "field_validated"] },
        "verified_at": { "type": ["string", "null"], "format": "date" },
        "verified_by": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "profileProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
        "manufacturer": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 }, "family": { "type": "string" }, "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "protocols": { "type": "array", "minItems": 1, "items": { "enum": ["modbus_tcp", "modbus_rtu"] } },
        "address_base": { "enum": [0, 1] }, "defaults": { "type": "object" }, "capabilities": { "type": "object" },
        "driver": { "type": "object" }, "documentation": { "type": "object" }, "validation": { "$ref": "#/$defs/validation" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "derived_points": { "type": "array", "items": { "$ref": "#/$defs/derivedPoint" } }
      }
    },
    "profile": {
      "allOf": [
        { "$ref": "#/$defs/profileProperties" },
        { "type": "object", "required": ["id", "manufacturer", "model", "category", "version", "protocols", "points"] }
      ],
      "unevaluatedProperties": false
    },
    "bundledProfile": {
      "allOf": [
        { "$ref": "#/$defs/profileProperties" },
        {
          "type": "object",
          "required": ["id", "manufacturer", "model", "category", "version", "protocols"],
          "properties": { "include_point_sets": { "type": "array", "items": { "type": "string" } } }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
